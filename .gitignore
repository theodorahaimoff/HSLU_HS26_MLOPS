# ---- Secrets: never commit these ----
.env
*.env
!.env.example
*.key
*credentials*.json
gcp-key*.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- Data (fetched by the feature pipeline, not versioned in git) ----
data/raw/*.csv
data/raw/*.parquet
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Experiment tracking / model artifacts ----
wandb/
mlruns/
*.pkl
*.joblib
model_registry_cache/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Docker ----
*.log

# ---- Terraform (if the stretch layer is ever added) ----
*.tfstate
*.tfstate.backup
.terraform/
