# ---- Secrets: never commit these ----
.env
*.env
!.env.example
*.key
*credentials*.json
gcp-key*.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---- Data (fetched by the pipelines, not versioned in git) ----
data/raw/*
data/feature_store
!data/raw/.gitkeep

# ---- Experiment tracking / model artifacts ----
wandb/
mlruns/
*.pkl
*.joblib
model_registry_cache/

# ---- Notebooks ----
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Docker ----
*.log

# ---- Terraform (if the stretch layer is ever added) ----
*.tfstate
*.tfstate.backup
.terraform/
